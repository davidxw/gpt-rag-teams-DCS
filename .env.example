# Local development settings. Copy to `.env` and fill in.
# In production, these values are supplied by the App Service Application
# Settings (typically backed by Key Vault references).

PORT=3978

# Bot identity for local dev — register an AAD app, then set EITHER the new
# Teams SDK names (preferred) OR the legacy MicrosoftApp* names. `src/config.ts`
# bridges MicrosoftApp* -> CLIENT_*/TENANT_ID for backward compatibility.
#
# Teams SDK auto-detects the auth method from these vars:
#   CLIENT_ID + CLIENT_SECRET + TENANT_ID  -> client-secret auth (typical local dev)
#   CLIENT_ID + TENANT_ID (no secret)      -> user-assigned managed identity (Azure)
# See: https://learn.microsoft.com/microsoftteams/platform/teams-sdk/essentials/app-authentication
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Legacy names (still honored as a fallback):
# MicrosoftAppId=
# MicrosoftAppPassword=
# MicrosoftAppTenantId=

# Orchestrator (point at the local Functions Core Tools instance for dev,
# or the deployed Function App URL).
ORCHESTRATOR_ENDPOINT=http://localhost:7071/api/orc

# Either supply a static function key for dev...
ORCHESTRATOR_FUNCTION_KEY=

# ...or let the bot fetch it via ARM listKeys (managed identity in Azure;
# `az login` locally via AzureCliCredential).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_ORCHESTRATOR_FUNC_NAME=
