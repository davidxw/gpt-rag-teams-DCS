# Local development settings. Copy to `.env` and fill in.
# In production, these values are supplied by the App Service Application
# Settings (typically backed by Key Vault references).

PORT=3978

# Bot identity for local dev — register an AAD app and set:
MicrosoftAppType=MultiTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# Orchestrator (point at the local Functions Core Tools instance for dev,
# or the deployed Function App URL).
ORCHESTRATOR_ENDPOINT=http://localhost:7071/api/orc

# Either supply a static function key for dev...
ORCHESTRATOR_FUNCTION_KEY=

# ...or let the bot fetch it via ARM listKeys (managed identity in Azure;
# `az login` locally via AzureCliCredential).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_ORCHESTRATOR_FUNC_NAME=
