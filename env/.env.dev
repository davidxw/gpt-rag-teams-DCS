# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Updating AZURE_SUBSCRIPTION_ID or AZURE_RESOURCE_GROUP_NAME after provision may also require an update to RESOURCE_SUFFIX, because some services require a globally unique name across subscriptions/resource groups.
AZURE_SUBSCRIPTION_ID=68dfa90d-6200-4bc6-bdad-178344084a61
AZURE_RESOURCE_GROUP_NAME=botservice
RESOURCE_SUFFIX=0e04ff

# Generated during provision, you can also add your own variables.
BOT_ID=
TEAMS_APP_ID=
BOT_AZURE_APP_SERVICE_RESOURCE_ID=
BOT_DOMAIN=

# Storage account holding source documents. The bot streams blobs via
# its managed identity (Storage Blob Data Reader required). Citation
# URLs in chat point at the bot's own GET /api/documents endpoint.
STORAGE_ACCOUNT=

# Optional override for the container name (default: documents).
# STORAGE_CONTAINER=documents