# This file includes environment variables that can be committed to git. It's gitignored by default because it represents your local development environment.

# Built-in environment variables
TEAMSFX_ENV=playground

# Environment variables used by Microsoft 365 Agents Playground
TEAMSAPPTESTER_PORT=56150

ORCHESTRATOR_ENDPOINT=https://fnorch0-cjrbxffnrxdc6.azurewebsites.net/api/orc

# Storage account holding source documents. The bot streams blobs via
# its managed identity (Storage Blob Data Reader required). For local
# playground runs, use `az login` so DefaultAzureCredential can pick up
# AzureCliCredential.
STORAGE_ACCOUNT=strag0ltpq2fb2vu5v2

# Optional override for the container name (default: documents).
# STORAGE_CONTAINER=documents

# Public host (no scheme) the bot is reachable at. Defaults to BOT_DOMAIN
# locally and WEBSITE_HOSTNAME in Azure App Service.
BOT_BASE_URL=http://localhost:3978